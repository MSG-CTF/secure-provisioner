PROVISIONER_STORE_MODE=postgres
PROVISIONER_DATABASE_URL=postgres://provisioner:provisioner@127.0.0.1:54329/provisioner_test?sslmode=disable
PROVISIONER_WORKERS=10
PROVISIONER_POLL_INTERVAL=200ms
PROVISIONER_LEASE_DURATION=3m
PROVISIONER_LEASE_RENEW_INTERVAL=1m
PROVISIONER_MAX_ATTEMPTS=4
PROVISIONER_RETRY_BASE_DELAY=1s

# FLAG 이미지에는 Backend 비밀값 조회 설정이 필요합니다
PROVISIONER_BACKEND_SECRET_URL=
PROVISIONER_BACKEND_SECRET_TOKEN=

# Optional image preparation (see docs/operations/image-preparation.md)
PROVISIONER_IMAGE_PREFETCH_ENABLED=false
PROVISIONER_IMAGE_PREFETCH_OBSERVE_INTERVAL=30s
PROVISIONER_IMAGE_PREFETCH_READINESS_TTL=60s
PROVISIONER_IMAGE_PREFETCH_MAX_ATTEMPTS=3
PROVISIONER_IMAGE_PREFETCH_WORKERS=2
PROVISIONER_IMAGE_PREFETCH_NODES=
PROVISIONER_IMAGE_PREPARATION_TOKEN_FILE=
PROVISIONER_IMAGE_READINESS_TOKEN_FILE=
