PROVISIONER_ADDR=127.0.0.1:8080
CTF_MOCK_ADDR=127.0.0.1:18080
CTF_MOCK_URL=http://127.0.0.1:18080
PROVISIONER_URL=http://127.0.0.1:8080
PROVISIONER_STORE_MODE=postgres
PROVISIONER_DATABASE_URL=postgres://provisioner:provisioner@127.0.0.1:55432/provisioner?sslmode=disable
PROVISIONER_WORKERS=10
PROVISIONER_POLL_INTERVAL=200ms
PROVISIONER_LEASE_DURATION=3m
PROVISIONER_MAX_RETRIES=3
PROVISIONER_RETRY_BASE_DELAY=1s
PROVISIONER_EXPIRATION_INTERVAL=5s
PROVISIONER_LOG_LEVEL=info
PROVISIONER_CLUSTER_MODE=fake
K3S_KUBECONFIG=/etc/rancher/k3s/k3s.yaml
K3S_PUBLIC_HOST=
K3S_VERIFICATION_HOST=127.0.0.1
CTF_MOCK_XSS_IMAGE=msg-ctf/reflected-xss@sha256:replace-with-built-image-digest
